<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SmartPDF Pairer"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="اختر ملف PDF الأصلي وملف الترجمة، ثم اختر نوع المعالجة."
            android:textSize="16sp" />

        <TextView
            android:id="@+id/originalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="الملف الأصلي: لم يتم الاختيار"
            android:textSize="16sp" />

        <Button
            android:id="@+id/selectOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختيار الملف الأصلي PDF" />

        <TextView
            android:id="@+id/arabicName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ملف الترجمة: لم يتم الاختيار"
            android:textSize="16sp" />

        <Button
            android:id="@+id/selectArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختيار ملف الترجمة PDF" />

        <TextView
            android:id="@+id/pageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اختر الملفين أولاً."
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/layoutGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <RadioButton
                android:id="@+id/arabicLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="العربي يسار ← الأصلي يمين" />
            <RadioButton
                android:id="@+id/originalLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الأصلي يسار ← العربي يمين" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="وظائف الدمج"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. دمج عادي — دون تعديل الملفات" />

        <Button
            android:id="@+id/smartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. الدمج الذكي — إكمال الترجمة الناقصة ثم الدمج" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="يفحص النص الإنجليزي المتبقي في ملف الترجمة، ويستخدم OCR عند تعذر استخراج النص، ويترجم المناطق القابلة للمعالجة في موضعها، ثم يصدر تقريرًا."
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="أدوات مستقلة"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ocrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3. OCR واستخراج النصوص إلى تقرير" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="حفظ / تصدير PDF" />

        <Button
            android:id="@+id/openButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="فتح PDF الناتج" />

    </LinearLayout>
</ScrollView>
